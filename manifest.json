{
  "manifest_version": 3,
  "name": "Slop Filter for LinkedIn",
  "version": "1.2.0",
  "version_name": "1.2.0-dev",
  "description": "Flags low-quality LinkedIn posts and shows you the phrase it caught.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.linkedin.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://www.linkedin.com/*"],
    "js": ["dom.js", "filters.js", "storage.js", "counters.js", "notice.js", "menu.js", "content.js"],
    "css": ["content.css"],
    "run_at": "document_idle"
  }],
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "options_ui": { "page": "settings.html", "open_in_tab": true },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
}
